rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // DEMO-ONLY — same caveat as firestore.rules: no auth check, anyone with
    // the URL can read an uploaded screenshot. Lock down before real use.
    match /payment-screenshots/{fileName} {
      allow write: if request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow read: if true;
    }
  }
}
