rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Real security now that the site has Firebase Auth: any visitor can
    // submit an order (no account required — guest checkout), but only the
    // signed-in admin account can read or update tickets (which include
    // customer names, phone numbers, addresses and payment screenshots).
    //
    // The email below MUST match business.js's `adminEmail` exactly — that
    // JS constant can't be read from here, so if you change one, change
    // both and republish these rules.
    match /orders/{orderId} {
      allow create: if true;
      allow read, update: if request.auth != null
        && request.auth.token.email == 'owner@cookiesland.demo';
      allow delete: if false;
    }

    // Admin-editable price/availability/photo overrides on top of the
    // static catalog (see src/context/CatalogContext.jsx) — everyone needs
    // to read these (it's what customers see), only the admin can write.
    match /catalogOverrides/{productId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'owner@cookiesland.demo';
    }
  }
}
